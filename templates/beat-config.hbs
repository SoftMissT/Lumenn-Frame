<div class="bc-section">
  <div class="bc-section-title">{{label.scene}}</div>
  <div class="bc-scene-preview">
    <div class="bc-thumb">
      {{#if scenePreview}}
        <img src="{{scenePreview}}" alt="{{scenePreviewName}}">
      {{else}}
        <span class="bc-no-thumb">{{label.none}}</span>
      {{/if}}
    </div>
    <span class="bc-scene-name {{#unless scenePreviewName}}unset{{/unless}}">{{#if scenePreviewName}}{{scenePreviewName}}{{else}}{{label.scene}} &mdash; {{label.none}}{{/if}}</span>
  </div>
  <div class="bc-row">
    <label for="lf-config-scene">{{label.scene}}</label>
    <select id="lf-config-scene" name="sceneId">
      <option value="">{{label.none}}</option>
      {{#each scenes}}
      <option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.name}}</option>
      {{/each}}
    </select>
  </div>
</div>

<div class="bc-section">
  <div class="bc-section-title">{{label.audioType}}</div>
  <div class="bc-row">
    <label for="lf-config-audio-type">{{label.audioType}}</label>
    <select id="lf-config-audio-type" name="audioType">
      <option value="none" {{#unless beat.audioSource}}selected{{/unless}}>{{label.none}}</option>
      <option value="track" {{#if (lumenn-eq beat.audioSource.type "track")}}selected{{/if}}>{{label.track}}</option>
      <option value="playlist" {{#if (lumenn-eq beat.audioSource.type "playlist")}}selected{{/if}}>{{label.playlist}}</option>
    </select>
  </div>
  <div class="bc-row" style="{{#unless (lumenn-eq beat.audioSource.type 'track')}}display:none;{{/unless}}">
    <label for="lf-config-track">{{label.audioTrack}}</label>
    <select id="lf-config-track" name="audioTrackId">
      {{#each playlists}}
      {{#each this.sounds}}
      <option value="{{this.uuid}}" {{#if this.selected}}selected{{/if}}>{{../name}} / {{this.name}}</option>
      {{/each}}
      {{/each}}
    </select>
  </div>
  <div class="bc-row" style="{{#unless (lumenn-eq beat.audioSource.type 'playlist')}}display:none;{{/unless}}">
    <label for="lf-config-playlist">{{label.audioPlaylist}}</label>
    <select id="lf-config-playlist" name="audioPlaylistId">
      {{#each playlists}}
      <option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.name}}</option>
      {{/each}}
    </select>
  </div>
</div>

<div class="bc-section">
  <div class="bc-section-title">{{label.crossfade}}</div>
  <div class="bc-row">
    <label for="lf-config-crossfade">{{label.crossfade}}</label>
    <input id="lf-config-crossfade" type="number" name="crossfadeDuration" min="0" step="100"
           value="{{beat.crossfadeDuration}}" placeholder="{{defaultCrossfade}}">
    <span class="bc-hint">{{label.crossfadeHint}}</span>
  </div>
</div>

<div class="bc-footer">
  <button type="submit">{{label.save}}</button>
</div>
