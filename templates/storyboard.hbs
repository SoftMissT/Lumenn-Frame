            <option value="">{{../label.hivePortNoRoom}}</option>
            {{#each this.rooms}}<option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.name}}</option>{{/each}}
          </select>
          <button class="lf-insp-x" data-insp-action="hive-port-remove" data-port-id="{{this.id}}" title="{{../label.hivePortRemove}}">&#10005;</button>
        </li>
        {{/each}}
      </ul>
      <div class="lf-insp-actions"><button data-insp-action="hive-port-add">{{label.hivePortAdd}}</button></div>
      <div class="lf-trans-card">
        <h4 class="lf-trans-title"><i class="fa-solid fa-door-open"></i> {{label.hiveTransition}}</h4>
        <select data-hive-field="transition.type">
          {{#each inspector.hive.transition.options}}
          <optgroup label="{{this.group}}">
            {{#each this.items}}<option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}
          </optgroup>
          {{/each}}
        </select>
        {{#if inspector.hive.transition.isVideo}}
        <label class="lf-insp-label">{{label.filmVideoFile}}</label>
        <div class="lf-pick-row">
          <input type="text" id="lf-hive-video-in" data-hive-field="transition.videoSrc" value="{{inspector.hive.transition.video.src}}" placeholder="stinger.webm">
          <button type="button" data-insp-action="pick-video" data-pick-for="#lf-hive-video-in" title="{{label.filmVideoFile}}"><i class="fa-solid fa-folder-open"></i></button>
        </div>
        <div class="lf-tr-chips lf-stinger-chips" role="group" aria-label="{{label.stingerReady}}">
          {{#each inspector.hive.transition.stingers}}<button type="button" class="lf-tr-chip{{#if this.on}} is-on{{/if}}" data-stinger-src="{{this.src}}" data-stinger-for="#lf-hive-video-in"><i class="fa-solid {{this.icon}}"></i> {{this.label}}</button>{{/each}}
        </div>
        <div class="lf-trans-row">
          <label>{{label.filmCutAt}}<input type="number" data-unit="s" min="0" step="0.1" data-hive-field="transition.cutAt" value="{{lumenn-sec inspector.hive.transition.video.cutAt}}"></label>
          <label class="lf-insp-check"><input type="checkbox" data-hive-field="transition.videoSound" {{#if inspector.hive.transition.video.sound}}checked{{/if}}> {{label.filmVideoSound}}</label>
        </div>
        {{/if}}
        <div class="lf-trans-row">
          <label>{{label.duration}} (s)<input type="number" data-unit="s" min="0" step="0.1" data-hive-field="transition.duration" value="{{lumenn-sec inspector.hive.transition.duration}}"></label>
          <label>{{label.filmMusic}}<select data-hive-field="transition.music">{{#each inspector.hive.transition.music}}<option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</select></label>
        </div>
        <label class="lf-insp-label">{{label.hiveTransitionAudio}}<input type="number" data-unit="s" min="0" step="0.1" data-hive-field="transition.crossfade" value="{{lumenn-sec inspector.hive.transition.crossfade}}"></label>
        {{#if inspector.hive.transition.isFilm}}
        <label class="lf-insp-label lf-insp-check"><input type="checkbox" data-hive-field="transition.caption" {{#if inspector.hive.transition.caption}}checked{{/if}}> {{label.hiveCaption}}</label>
        {{/if}}
      </div>
      <div class="lf-trans-card">
        <h4 class="lf-trans-title"><i class="fa-solid fa-film"></i> {{label.hiveExitTransition}}</h4>
        <select data-hive-field="exit.type">
          {{#each inspector.hive.exit.options}}
          <optgroup label="{{this.group}}">
            {{#each this.items}}<option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}
          </optgroup>
          {{/each}}
        </select>
        {{#if inspector.hive.exit.isVideo}}
        <label class="lf-insp-label">{{label.filmVideoFile}}</label>
        <div class="lf-pick-row">
          <input type="text" id="lf-hive-video-out" data-hive-field="exit.videoSrc" value="{{inspector.hive.exit.video.src}}" placeholder="stinger.webm">
          <button type="button" data-insp-action="pick-video" data-pick-for="#lf-hive-video-out" title="{{label.filmVideoFile}}"><i class="fa-solid fa-folder-open"></i></button>
        </div>
        <div class="lf-tr-chips lf-stinger-chips" role="group" aria-label="{{label.stingerReady}}">
          {{#each inspector.hive.exit.stingers}}<button type="button" class="lf-tr-chip{{#if this.on}} is-on{{/if}}" data-stinger-src="{{this.src}}" data-stinger-for="#lf-hive-video-out"><i class="fa-solid {{this.icon}}"></i> {{this.label}}</button>{{/each}}
        </div>
        <div class="lf-trans-row">
          <label>{{label.filmCutAt}}<input type="number" data-unit="s" min="0" step="0.1" data-hive-field="exit.cutAt" value="{{lumenn-sec inspector.hive.exit.video.cutAt}}"></label>
          <label class="lf-insp-check"><input type="checkbox" data-hive-field="exit.videoSound" {{#if inspector.hive.exit.video.sound}}checked{{/if}}> {{label.filmVideoSound}}</label>
        </div>
        {{/if}}
        <div class="lf-trans-row">
          <label>{{label.duration}} (s)<input type="number" data-unit="s" min="0" step="0.1" data-hive-field="exit.duration" value="{{lumenn-sec inspector.hive.exit.duration}}"></label>
          <label>{{label.filmMusic}}<select data-hive-field="exit.music">{{#each inspector.hive.exit.music}}<option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</select></label>
        </div>
        <label class="lf-insp-label">{{label.hiveTransitionAudio}}<input type="number" data-unit="s" min="0" step="0.1" data-hive-field="exit.crossfade" value="{{lumenn-sec inspector.hive.exit.crossfade}}"></label>
        {{#if inspector.hive.exit.isFilm}}
        <label class="lf-insp-label lf-insp-check"><input type="checkbox" data-hive-field="exit.caption" {{#if inspector.hive.exit.caption}}checked{{/if}}> {{label.hiveCaption}}</label>
        {{/if}}
        <p class="lf-insp-p lf-film-note"><i class="fa-solid fa-eye-slash"></i> {{label.filmPlayersOnly}}</p>
      </div>
      {{#if inspector.hive.pending.length}}
      <label class="lf-insp-label">{{label.hivePending}}</label>
      <p class="lf-insp-p">{{label.hivePendingHint}}</p>
      <ul class="lf-hive-pending">
        {{#each inspector.hive.pending}}
        <li>
          <span class="lf-hive-name">{{this.kindLabel}}: {{this.label}}</span>
          <select data-hive-relink="{{this.nodeId}}">
            {{#each this.options}}<option value="{{this.id}}">{{this.name}}</option>{{/each}}
          </select>
          <button data-insp-action="hive-relink" data-node-id="{{this.nodeId}}">{{../label.hiveRelink}}</button>
        </li>
        {{/each}}
      </ul>
      {{/if}}
      <div class="lf-insp-actions"><button class="danger" data-insp-action="hive-unmark">{{label.hiveUnmark}}</button></div>
      {{else}}
      <div class="lf-insp-actions"><button data-insp-action="hive-mark">{{label.hiveMark}}</button></div>
      {{/if}}
      <label class="lf-insp-label">{{label.hiveLibrary}}</label>
      {{#if inspector.hive.library.length}}
      <ul class="lf-hive-library">
        {{#each inspector.hive.library}}
        <li draggable="true" data-hive-drag="{{this.id}}">
          <span class="lf-hive-name"><i class="fa-solid fa-cubes"></i> {{this.name}} <small>{{this.rooms}} {{../label.hiveRooms}}</small></span>
          {{#if this.usedIn}}<small class="lf-hive-used">{{../label.hiveUsedIn}}: {{this.usedIn}}</small>{{/if}}
          <span class="lf-hive-btns">
            {{#unless this.isCurrent}}
            <button data-insp-action="hive-insert" data-hive-id="{{this.id}}">{{../label.hiveInsert}}</button>
            <button data-insp-action="hive-open" data-hive-id="{{this.id}}">{{../label.hiveOpen}}</button>
            {{/unless}}
            <button data-insp-action="hive-export" data-hive-id="{{this.id}}">{{../label.hiveExport}}</button>
          </span>
        </li>
        {{/each}}
      </ul>
      {{else}}
      <p class="lf-insp-p">{{label.hiveLibraryEmpty}}</p>
      {{/if}}
      <div class="lf-insp-actions"><button data-insp-action="hive-import">{{label.hiveImport}}</button></div>
      {{/if}}
      {{#if inspector.audioNodeIndex.length}}
      <label class="lf-insp-label">{{label.audioNodes}}</label>
      <ul class="lf-insp-edges lf-audio-node-index">
        {{#each inspector.audioNodeIndex}}
        <li>
          <button class="lf-insp-edge-open" data-insp-action="focus-node" data-insp-node="{{this.id}}" title="{{../label.focusNode}}">
            <i class="fa-solid fa-music"></i>
            <span>{{this.name}}</span>
          </button>
        </li>
        {{/each}}
      </ul>
      {{/if}}
      {{/if}}
    </div>
  </div>
</div>
