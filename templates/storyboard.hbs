<div class="lf-root" data-ws="{{workspace}}">
  <div class="lf-topbar">
    <span class="lf-brand">Lumenn Frame</span>
    <div class="lf-nav" role="group" aria-label="{{label.browserTitle}}">
      <button type="button" class="lf-top-btn lf-nav-arrow" data-action="nav-back" title="{{label.historyBack}}" aria-label="{{label.historyBack}}" {{#unless canBack}}disabled{{/unless}}><i class="fa-solid fa-chevron-left"></i></button>
      <button type="button" class="lf-top-btn lf-nav-arrow" data-action="nav-forward" title="{{label.historyForward}}" aria-label="{{label.historyForward}}" {{#unless canForward}}disabled{{/unless}}><i class="fa-solid fa-chevron-right"></i></button>
      <button type="button" class="lf-sb-switch{{#if isHiveGraph}} is-hive{{/if}}" data-action="browser-open" title="{{label.browse}}" aria-haspopup="dialog">
        <i class="fa-solid {{#if isHiveGraph}}fa-cubes{{else}}fa-film{{/if}}"></i>
        <span class="lf-sb-name">{{activeGraph.name}}</span>
        <i class="fa-solid fa-table-cells-large lf-sb-grid"></i>
      </button>
    </div>
    {{#if isGM}}
    {{!-- Workspaces como no Premiere/DaVinci: a mesma janela muda de função. --}}
    <nav class="lf-ws-tabs" role="tablist" aria-label="Workspaces">
      {{#each workspaces}}<button type="button" role="tab" class="{{#if this.on}}is-on{{/if}}" aria-selected="{{#if this.on}}true{{else}}false{{/if}}" data-action="workspace" data-ws="{{this.id}}"><i class="fa-solid {{this.icon}}" aria-hidden="true"></i> {{this.label}}</button>{{/each}}
    </nav>
    {{/if}}    {{!-- Topo enxuto (conceito 02): só o que se usa sempre. O resto mora no menu "Mais". --}}
    <div class="lf-mode-toggle">
      <button class="{{#if (lumenn-eq mode 'edit')}}active{{/if}}" data-action="toggle-mode">{{label.editMode}}</button>
      <button class="{{#if (lumenn-eq mode 'live')}}active{{/if}}" data-action="toggle-mode">{{label.liveMode}}</button>
    </div>
    {{#if isGM}}
    <div class="lf-top-actions" role="group" aria-label="{{label.graph}}">
      <button type="button" class="lf-top-btn" data-action="create-graph" title="{{label.createGraph}}"><i class="fa-solid fa-plus" aria-hidden="true"></i> {{label.addStoryboard}}</button>
      {{#if editable}}
      <button type="button" class="lf-top-btn lf-add-hive" data-action="add-hive" title="{{label.addHiveHint}}"><i class="fa-solid fa-plus" aria-hidden="true"></i> {{label.addHive}}</button>
      {{/if}}
      <button type="button" class="lf-top-btn{{#if hiveMap}} is-on{{/if}}" data-action="hive-map" title="{{label.viewHiveHint}}" aria-pressed="{{#if hiveMap}}true{{else}}false{{/if}}"><i class="fa-solid fa-map" aria-hidden="true"></i> {{label.viewHive}}</button>
      <button type="button" class="lf-top-btn" data-action="open-destinations" title="{{label.neuralDestinationsHint}}"><i class="fa-solid fa-diagram-project" aria-hidden="true"></i> {{label.neuralDestinations}}</button>
    </div>
    {{/if}}
    <span class="lf-topbar-spacer"></span>
    <div class="lf-camera-controls">
      <button data-camera="zoom-out" title="Zoom out" aria-label="Zoom out">−</button>
      <span class="lf-camera-percent" data-camera-percent>100%</span>
      <button data-camera="zoom-in" title="Zoom in" aria-label="Zoom in">+</button>
    </div>
    <div class="lf-more">
      <button type="button" class="lf-top-btn lf-more-btn" data-action="more-toggle" aria-haspopup="menu" aria-label="{{label.more}}" title="{{label.more}}"><i class="fa-solid fa-ellipsis-vertical" aria-hidden="true"></i></button>
      <div class="lf-more-menu" role="menu">
        <button type="button" role="menuitem" data-camera="fit"><i class="fa-solid fa-expand" aria-hidden="true"></i> {{label.fit}}</button>
        <button type="button" role="menuitem" data-camera="reset"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i> {{label.zoomReset}}</button>
        <button type="button" role="menuitem" data-action="workspace-toggle"><i class="fa-solid fa-up-right-and-down-left-from-center" aria-hidden="true"></i> {{label.expand}}</button>
        {{#if isGM}}
        <hr>
        <button type="button" role="menuitem" data-action="jump-intro" title="{{label.neuralIntroHint}}"><i class="fa-solid fa-flag" aria-hidden="true"></i> {{label.neuralIntro}}</button>
        <button type="button" role="menuitem" data-action="jump-output" title="{{label.neuralOutputHint}}"><i class="fa-solid fa-flag-checkered" aria-hidden="true"></i> {{label.neuralOutput}}</button>
        {{#if editable}}
        <hr>
        <button type="button" role="menuitem" data-action="rename-graph"><i class="fa-solid fa-pen" aria-hidden="true"></i> {{label.renameGraph}}</button>
        <button type="button" role="menuitem" data-action="sort-graphs"><i class="fa-solid fa-arrow-down-a-z" aria-hidden="true"></i> {{label.sortGraphs}}</button>
        <button type="button" role="menuitem" class="is-danger" data-action="delete-graph"><i class="fa-solid fa-trash" aria-hidden="true"></i> {{label.deleteGraph}}</button>
        {{/if}}
        {{/if}}
        <hr>
        <button type="button" role="menuitem" data-action="open-guide"><i class="fa-solid fa-book-open" aria-hidden="true"></i> {{label.guide}}</button>
      </div>
    </div>
  </div>

  <div class="lf-body">
    {{#unless (lumenn-eq workspace 'graph')}}<div class="lf-workspace" data-ws="{{workspace}}"></div>{{/unless}}
    <div class="lf-toolbar-left">
      {{#if editable}}
      <button class="lf-tool{{#if (lumenn-eq tool 'select')}} active{{/if}}" data-tool="select" title="{{label.select}}"><i class="fa-solid fa-mouse-pointer"></i></button>
      {{!-- Barra enxuta (conceito 07): cena e áudio chegam arrastando da sidebar; link sai da porta; mover = espaço ou botão do meio; Hive nasce no "+ Hive" do topo. --}}
      <button class="lf-tool" data-camera="fit" title="{{label.fit}}" aria-label="{{label.fit}}"><i class="fa-solid fa-expand"></i></button>
      {{#if isHiveGraph}}
      <button class="lf-tool{{#if (lumenn-eq tool 'encounter')}} active{{/if}}" data-tool="encounter" title="{{label.addEncounter}}"><i class="fa-solid fa-bolt"></i></button>
      {{/if}}
      {{/if}}
    </div>

    <div class="lf-viewport">
      {{#if hiveMap}}
      <section class="lf-map" role="dialog" aria-label="{{label.viewHive}}">
        <header class="lf-map-head">
          <div>
            <h2><i class="fa-solid {{#if hiveMap.isHive}}fa-cubes{{else}}fa-film{{/if}}" aria-hidden="true"></i> {{hiveMap.name}}</h2>
            <p>{{hiveMap.hiveCount}} {{label.mapHives}} · {{hiveMap.sceneCount}} {{label.mapPlaces}}{{#if hiveMap.isHive}} · {{hiveMap.entries}} {{label.mapEntries}} · {{hiveMap.exits}} {{label.mapExits}}{{/if}}</p>
          </div>
          <button type="button" class="lf-map-close" data-action="hive-map" aria-label="Esc"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
        </header>
        {{#if hiveMap.hives.length}}
        <div class="lf-map-grid">
          {{#each hiveMap.hives}}
          <article class="lf-map-card{{#if this.missing}} is-missing{{/if}}">
            <h3><i class="fa-solid fa-cubes" aria-hidden="true"></i> {{#if this.name}}{{this.name}}{{else}}{{../label.mapMissing}}{{/if}}</h3>
            <p class="lf-map-meta">{{this.sceneCount}} {{../label.mapPlaces}} · {{this.subHives}} {{../label.mapHives}} · {{this.entries}}↘ {{this.exits}}↗</p>
            <ul class="lf-map-places">
              {{#each this.places}}<li>{{this}}</li>{{/each}}
              {{#if this.more}}<li class="is-more">+{{this.more}}</li>{{/if}}
            </ul>
            {{!-- Só na Edição: no Ao Vivo, entrar numa Hive moveria a mesa. --}}
            {{#unless this.missing}}{{#if (lumenn-eq ../mode 'edit')}}<button type="button" class="lf-map-open" data-action="map-open" data-ref="{{this.refId}}">{{../label.mapOpen}}</button>{{else}}<p class="lf-map-live">{{../label.mapLive}}</p>{{/if}}{{/unless}}
          </article>
          {{/each}}
        </div>
        {{else}}
        <p class="lf-map-empty">{{label.mapEmpty}}</p>
        {{/if}}
      </section>
      {{/if}}
      {{#if browser.open}}
      <section class="lf-browser" role="dialog" aria-label="{{label.browserTitle}}">
        <header class="lf-browser-head">
          <h2><i class="fa-solid fa-clapperboard"></i> {{label.browserTitle}}</h2>
          <nav class="lf-browser-tabs">
            {{#each browser.tabs}}
            <button type="button" class="{{#if this.active}}active{{/if}}" data-action="browser-filter" data-filter="{{this.id}}">{{#if (lumenn-eq this.id 'all')}}{{../label.browserAll}}{{/if}}{{#if (lumenn-eq this.id 'boards')}}{{../label.browserStoryboards}}{{/if}}{{#if (lumenn-eq this.id 'hives')}}{{../label.browserHives}}{{/if}}</button>
            {{/each}}
          </nav>
          <button type="button" class="lf-browser-close" data-action="browser-close" aria-label="Esc"><i class="fa-solid fa-xmark"></i></button>
        </header>
        <div class="lf-browser-grid">
          {{#each browser.cards}}
          <button type="button" class="lf-sb-card{{#if this.isHive}} is-hive{{/if}}{{#if this.isCurrent}} is-current{{/if}}" data-action="browser-go" data-graph="{{this.id}}">
            <span class="lf-sb-thumb">{{#if this.thumb}}<img src="{{this.thumb}}" alt="" loading="lazy" draggable="false">{{else}}<i class="fa-solid {{#if this.isHive}}fa-cubes{{else}}fa-film{{/if}}"></i>{{/if}}</span>
            <span class="lf-sb-meta">
              <strong>{{this.name}}</strong>
              <small>{{this.scenes}} {{../label.browserScenes}}{{#if this.isHive}} · {{../label.hiveBadge}}{{/if}}{{#if this.isCurrent}} · {{../label.browserCurrent}}{{/if}}</small>
            </span>
          </button>
          {{/each}}
        </div>
      </section>
      {{/if}}
      {{#if trail}}
      <div class="lf-trail" aria-label="{{label.trailLabel}}">
        <span class="lf-trail-label"><i class="fa-solid fa-route"></i> {{label.trailLabel}}</span>
        {{#each trail.crumbs}}<span class="lf-trail-crumb">{{this.name}}</span>{{#unless @last}}<span class="lf-trail-sep">&rsaquo;</span>{{/unless}}{{/each}}
        {{#if trail.canExit}}
        {{#each trail.exitPorts}}<button type="button" class="lf-top-btn" data-action="hive-exit" data-port="{{this.id}}" title="{{../label.hiveExitHint}}">{{../label.trailExitVia}}: {{this.name}}</button>{{/each}}
        <button type="button" class="lf-top-btn" data-action="hive-exit" title="{{label.hiveExitHint}}"><i class="fa-solid fa-right-from-bracket"></i> {{label.trailExit}}</button>
        {{/if}}
      </div>
      {{/if}}
      {{#if editTrail}}
      <div class="lf-trail" aria-label="{{label.trailLabel}}">
        <button type="button" class="lf-top-btn" data-action="edit-back"><i class="fa-solid fa-arrow-left"></i> {{label.editBack}} {{editTrail.back}}</button>
        {{#each editTrail.crumbs}}{{#if @last}}<span class="lf-trail-crumb" aria-current="location">{{this.name}}</span>{{else}}<button type="button" class="lf-trail-crumb lf-trail-link" data-action="edit-goto" data-index="{{@index}}" data-tooltip="{{../label.trailGoto}}">{{this.name}}</button><span class="lf-trail-sep">&rsaquo;</span>{{/if}}{{/each}}
      </div>
      {{/if}}
      <div class="lf-camera">
        <svg class="lf-edges"></svg>
        {{#each nodes}}
        <div class="lf-node lf-node-{{this.type}}{{#if (lumenn-eq this.type 'group')}} lf-group-{{#if this.groupOpen}}open{{else}}closed{{/if}}{{/if}}{{#if (lumenn-eq this.type 'audio')}} lf-audio-role-{{this.audioRole}}{{/if}}{{#if this.isActive}} active{{/if}}{{#if this.isNavigable}} navigable{{/if}}{{#if this.isPlayable}} playable{{/if}}{{#if this.isPlaying}} playing{{/if}}{{#if this.isDimmed}} dimmed{{/if}}{{#if this.selected}} selected{{/if}}{{#if this.targetHi}} target-hi{{/if}}{{#if this.armed}} armed{{/if}}"
             data-id="{{this.id}}"
             data-type="{{this.type}}"
             data-parent-id="{{this.parentId}}"
             data-intent="{{this.clickIntent}}"
             data-tooltip="{{this.hint}}" data-tooltip-direction="UP"
             style="left:{{this.position.x}}px;top:{{this.position.y}}px;width:{{this.width}}px;height:{{this.height}}px;--node-color:{{this.color}};">
          {{#if this.anchorIntro}}<span class="lf-anchor-badge lf-anchor-intro">{{../label.neuralIntro}}</span>{{/if}}
          {{#if this.anchorOutput}}<span class="lf-anchor-badge lf-anchor-output">{{../label.neuralOutput}}</span>{{/if}}
          <div class="lf-node-content">
            <div class="lf-node-head"></div>
            {{#if (lumenn-eq this.type 'group')}}
            <div class="lf-group-head">
              <span class="lf-group-title"><i class="fa-solid fa-object-group"></i> {{this.groupLabel}}</span>
              <span class="lf-group-count">{{this.groupCount}} {{../label.groupRooms}}</span>
              {{#if (lumenn-eq ../mode 'edit')}}
              <button type="button" class="lf-group-toggle" data-group-toggle="{{this.id}}" title="{{../label.groupToggle}}"><i class="fa-solid fa-chevron-{{#if this.groupOpen}}up{{else}}down{{/if}}"></i></button>
              {{else}}
              {{#if ../isGM}}
              <button type="button" class="lf-group-toggle{{#if this.groupLocked}} active{{/if}}" data-group-lock="{{this.id}}" title="{{#if this.groupLocked}}{{../label.groupUnlock}}{{else}}{{../label.groupLock}}{{/if}}"><i class="fa-solid fa-lock{{#if this.groupLocked}}-open{{/if}}"></i></button>
              {{/if}}
              {{/if}}
            </div>
            {{/if}}
            {{#if (lumenn-eq this.type 'scene')}}
            <div class="lf-node-thumb">
              {{#if this.sceneThumb}}<img src="{{this.sceneThumb}}" alt="{{this.sceneName}}" loading="lazy" draggable="false">{{else}}<span class="lf-node-thumb-ph"><i class="fa-solid fa-image"></i></span>{{/if}}
              <span class="lf-node-preload" data-scene-id="{{this.sceneId}}" data-state="{{this.preloadState}}" title="{{this.preloadLabel}}" aria-label="{{this.preloadLabel}}"></span>
            </div>
            <div class="lf-node-title">{{this.sceneName}}</div>
            <div class="lf-node-tag">{{#if this.isActive}}<span class="lf-badge-live">{{../label.setInitial}}</span>{{/if}}<i class="fa-solid fa-image"></i> Scene</div>
            {{/if}}
            {{#if (lumenn-eq this.type 'audio')}}
            <div class="lf-node-title"><i class="fa-solid fa-music"></i> {{this.audioLabel}}</div>
            <div class="lf-node-tag"><span class="lf-audio-role-badge">{{this.audioRoleLabel}}</span> {{this.audioBadge}}</div>
            <div class="lf-node-wave"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
            {{/if}}
            {{#if (lumenn-eq this.type 'note')}}
            <div class="lf-node-title">{{this.data.title}}</div>
            <div class="lf-node-body">{{this.data.body}}</div>
            <div class="lf-node-tag"><i class="fa-solid fa-note-sticky"></i> Note</div>
            {{/if}}
            {{#if (lumenn-eq this.type 'hive-ref')}}
            <div class="lf-node-thumb">
              {{#if this.hiveThumb}}<img src="{{this.hiveThumb}}" alt="{{this.hiveName}}" loading="lazy" draggable="false">{{else}}<span class="lf-node-thumb-ph"><i class="fa-solid fa-cubes"></i></span>{{/if}}
            </div>
            <div class="lf-node-title"><i class="fa-solid fa-cubes"></i> {{this.hiveName}}</div>
            <div class="lf-node-tag"><span class="lf-hive-badge">{{../label.hiveBadge}}</span> {{this.hiveRooms}} {{../label.hiveRooms}} &middot; {{this.hivePortName}}</div>
            {{#if ../isGM}}{{#unless this.hiveMissing}}<button type="button" class="lf-hive-enter" data-hive-enter="{{this.id}}"><i class="fa-solid fa-door-open"></i> {{../label.hiveEnter}}</button>{{/unless}}{{/if}}
            {{/if}}
            {{#if (lumenn-eq this.type 'encounter')}}
            <div class="lf-node-title"><i class="fa-solid fa-bolt"></i> {{this.encTitle}}</div>
            <div class="lf-node-tag"><span class="lf-audio-role-badge">{{this.encTypeLabel}}</span></div>
            <div class="lf-node-wave"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
            {{/if}}
          </div>
          {{#if (lumenn-eq this.type 'hive-ref')}}
          {{#if this.portHub}}
          {{#if this.portHubPopover}}<details class="lf-port-hub is-pop"><summary title="{{../label.hivePorts}}"><i class="fa-solid fa-plug"></i> {{../label.hivePorts}} <b>{{this.portHub.entries.length}}/{{this.portHub.exits.length}}</b>{{#if this.portHub.orphanCount}} <span class="lf-hub-orphan" title="{{../label.hivePortOrphan}}">!</span>{{/if}}</summary>{{else}}<div class="lf-port-hub">{{/if}}
            <ul class="lf-hub-side lf-hub-in">
              {{#each this.portHub.entries}}
              <li class="lf-hub-port{{#if this.links}} is-linked{{/if}}" data-port="{{this.socket}}" data-node="{{../id}}" data-entry-port="{{this.id}}" title="{{this.title}}"><i class="lf-hub-ring"></i><span class="lf-hub-name">{{this.name}}</span><b>{{this.links}}</b></li>
              {{/each}}
            </ul>
            <ul class="lf-hub-side lf-hub-out">
              {{#each this.portHub.exits}}
              <li class="lf-hub-port{{#if this.links}} is-linked{{/if}}" data-port="{{this.socket}}" data-node="{{../id}}" data-exit-port="{{this.id}}" title="{{this.title}}"><span class="lf-hub-name">{{this.name}}</span><b>{{this.links}}</b><i class="lf-hub-ring"></i></li>
              {{/each}}
            </ul>
          {{#if this.portHubPopover}}</details>{{else}}</div>{{/if}}
          {{/if}}
          {{/if}}
          <div class="lf-ports">
            {{#if (lumenn-eq this.type 'encounter')}}
            <span class="lf-port lf-port-in lf-port-audio" data-port="audio-in" data-node="{{this.id}}" title="AUDIO IN"></span>
            {{/if}}
            {{#if (lumenn-eq this.type 'hive-ref')}}
            <span class="lf-port lf-port-in lf-port-flow-in" data-port="flow-in" data-node="{{this.id}}" title="FLOW IN"></span>
            <span class="lf-port lf-port-out lf-port-flow-out" data-port="flow-out" data-node="{{this.id}}" title="FLOW OUT"></span>
            <span class="lf-port lf-port-audio" data-port="audio-in" data-node="{{this.id}}" title="AUDIO IN"></span>
            {{/if}}
            {{#if (lumenn-eq this.type 'scene')}}
            <span class="lf-port lf-port-in lf-port-flow-in" data-port="flow-in" data-node="{{this.id}}" title="FLOW IN"></span>
            <span class="lf-port lf-port-out lf-port-flow-out" data-port="flow-out" data-node="{{this.id}}" title="FLOW OUT"></span>
            <span class="lf-port lf-port-audio" data-port="audio-in" data-node="{{this.id}}" title="AUDIO IN"></span>
            {{/if}}
            {{#if (lumenn-eq this.type 'audio')}}
            <span class="lf-port lf-port-in lf-port-audio" data-port="audio-in" data-node="{{this.id}}" title="AUDIO IN"></span>
            <span class="lf-port lf-port-out lf-port-audio" data-port="audio-out" data-node="{{this.id}}" title="AUDIO OUT"></span>
            {{/if}}
          </div>
        </div>
        {{/each}}
      </div>
      {{#if showConnectHint}}
      <div class="lf-connect-hint">{{connectHint}}</div>
      {{/if}}
      {{#if editable}}
      <details class="lf-library-dock">
        <summary><i class="fa-solid fa-cubes"></i> {{label.hiveLibrary}} ({{library.length}})</summary>
        {{#if library.length}}
        <ul>
          {{#each library}}
          <li draggable="true" data-hive-drag="{{this.id}}">
            <span class="lf-hive-name">{{this.name}} <small>{{this.rooms}} {{../label.hiveRooms}}</small></span>
            <span class="lf-hive-btns">
              <button type="button" data-insp-action="hive-insert" data-hive-id="{{this.id}}">{{../label.hiveInsert}}</button>
              <button type="button" data-insp-action="hive-open" data-hive-id="{{this.id}}">{{../label.hiveOpen}}</button>
            </span>
          </li>
          {{/each}}
        </ul>
        {{else}}
        <p>{{label.groupToHiveHint}}</p>
        {{/if}}
      </details>
      <details class="lf-audio-legend" aria-label="Legenda de áudio">
        <summary>{{label.legend}}</summary>
        <span class="lf-audio-key lf-audio-key-scene"><i></i>{{label.scene}}</span>
        <span class="lf-audio-key lf-audio-key-music"><i></i>{{label.musicRole}}</span>
        <span class="lf-audio-key lf-audio-key-sfx"><i></i>{{label.sfxRole}}</span>
        <span class="lf-audio-key lf-audio-key-note"><i></i>{{label.note}}</span>
        <span class="lf-audio-key lf-audio-key-active"><i></i>{{label.activeState}}</span>
        <span class="lf-audio-key lf-audio-key-navigable"><i></i>{{label.navigableState}}</span>
        <span class="lf-audio-key lf-audio-key-selected"><i></i>{{label.selectedState}}</span>
        <span class="lf-audio-key lf-audio-key-target"><i></i>{{label.targetState}}</span>
        <span class="lf-audio-key lf-audio-key-flow-in"><i></i>FLOW IN</span>
        <span class="lf-audio-key lf-audio-key-flow-out"><i></i>FLOW OUT</span>
        <span class="lf-audio-key lf-audio-key-left"><i></i>L / IN</span>
        <span class="lf-audio-key lf-audio-key-right"><i></i>R / OUT</span>
      </details>
      {{/if}}
      {{#if transitioning}}
      <div class="lf-transitioning"><span class="lf-transitioning-dot"></span>{{label.transition}}</div>
      {{/if}}
      {{#unless nodes.length}}
      <div class="lf-empty-state">
        <div class="lf-empty-icon"><i class="fa-solid fa-image"></i></div>
        <div class="lf-empty-title">{{label.emptyState}}</div>
        <div class="lf-empty-hint">{{label.emptyHint}}<br>{{label.dropHint}}</div>
      </div>
      {{/unless}}
    </div>

    <div class="lf-inspector">
      {{#if (lumenn-eq inspector.kind 'node')}}
        {{#if (lumenn-eq inspector.nodeType 'scene')}}
        <h3 class="lf-insp-title">{{label.scene}}</h3>
        <label class="lf-insp-label">{{label.sceneDoc}}</label>
        <select data-insp="data.sceneId">
          <option value="">{{label.none}}</option>
          {{#each inspector.scenes}}
          <option value="{{this.id}}" {{#if (lumenn-eq this.id ../inspector.node.data.sceneId)}}selected{{/if}}>{{this.name}}</option>
          {{/each}}
        </select>
        <label class="lf-insp-label lf-insp-check" title="{{label.visitableHint}}"><input type="checkbox" data-insp="data.visitable" {{#if inspector.node.data.visitable}}checked{{/if}}> {{label.visitable}}</label>
        {{/if}}
        {{#if inspector.hasConnections}}
        <h3 class="lf-insp-title">{{label.connections}}</h3>
        {{#if editable}}
        {{#if inspector.hasFlowOut}}
        <label class="lf-insp-label">{{label.outgoing}}</label>
        {{#if inspector.flowTargets.length}}
        <select data-insp-pick="flowTarget">
