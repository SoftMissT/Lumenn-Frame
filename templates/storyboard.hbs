<div class="lf-root">
  <div class="lf-topbar">
    <span class="lf-brand">Lumenn Frame</span>
    {{#if graphs.length}}
    <select class="lf-graph-selector" data-graph-selector>
      {{#each graphs}}
      <option value="{{this.id}}" {{#if (lumenn-eq this.id ../activeGraph.id)}}selected{{/if}}>{{this.name}}</option>
      {{/each}}
    </select>
    {{/if}}
    {{#if isGM}}
    <button class="lf-top-btn" data-action="create-graph" title="{{label.createGraph}}">+</button>
    {{/if}}
    <div class="lf-mode-toggle">
      <button class="{{#if (lumenn-eq mode 'edit')}}active{{/if}}" data-action="toggle-mode">{{label.editMode}}</button>
      <button class="{{#if (lumenn-eq mode 'live')}}active{{/if}}" data-action="toggle-mode">{{label.liveMode}}</button>
    </div>
    <span class="lf-topbar-spacer"></span>
    <div class="lf-camera-controls">
      <button data-camera="zoom-out" title="Zoom out">-</button>
      <span class="lf-camera-percent" data-camera-percent>100%</span>
      <button data-camera="reset" title="100%">100%</button>
      <button data-camera="zoom-in" title="Zoom in">+</button>
      <button data-camera="fit" title="Fit All">Fit</button>
    </div>
    <button class="lf-top-btn" data-action="workspace-toggle">{{label.expand}}</button>
  </div>

  <div class="lf-body">
    <div class="lf-toolbar-left">
      {{#if editable}}
      <button class="lf-tool{{#if (lumenn-eq tool 'select')}} active{{/if}}" data-tool="select" title="{{label.select}}"><i class="fa-solid fa-mouse-pointer"></i></button>
      <button class="lf-tool{{#if (lumenn-eq tool 'hand')}} active{{/if}}" data-tool="hand" title="{{label.hand}}"><i class="fa-solid fa-hand"></i></button>
      <button class="lf-tool{{#if (lumenn-eq tool 'connect')}} active{{/if}}" data-tool="connect" title="{{label.connect}}"><i class="fa-solid fa-share-nodes"></i></button>
      <button class="lf-tool{{#if (lumenn-eq tool 'scene')}} active{{/if}}" data-tool="scene" title="{{label.addScene}}"><i class="fa-solid fa-image"></i></button>
      <button class="lf-tool{{#if (lumenn-eq tool 'audio')}} active{{/if}}" data-tool="audio" title="{{label.addAudio}}"><i class="fa-solid fa-music"></i></button>
      <button class="lf-tool{{#if (lumenn-eq tool 'note')}} active{{/if}}" data-tool="note" title="{{label.addNote}}"><i class="fa-solid fa-note-sticky"></i></button>
      {{/if}}
    </div>

    <div class="lf-viewport">
      <div class="lf-camera">
        <svg class="lf-edges"></svg>
        {{#each nodes}}
        <div class="lf-node lf-node-{{this.type}}{{#if (lumenn-eq this.type 'audio')}} lf-audio-role-{{this.audioRole}}{{/if}}{{#if this.isActive}} active{{/if}}{{#if this.isNavigable}} navigable{{/if}}{{#if this.isDimmed}} dimmed{{/if}}{{#if this.selected}} selected{{/if}}{{#if this.targetHi}} target-hi{{/if}}"
             data-id="{{this.id}}"
             style="left:{{this.position.x}}px;top:{{this.position.y}}px;width:{{this.width}}px;height:{{this.height}}px;--node-color:{{this.color}};">
          <div class="lf-node-content">
            <div class="lf-node-head"></div>
            {{#if (lumenn-eq this.type 'scene')}}
            <div class="lf-node-thumb">
              {{#if this.sceneThumb}}<img src="{{this.sceneThumb}}" alt="{{this.sceneName}}" loading="lazy" draggable="false">{{else}}<span class="lf-node-thumb-ph"><i class="fa-solid fa-image"></i></span>{{/if}}
            </div>
            <div class="lf-node-title">{{this.sceneName}}</div>
            <div class="lf-node-tag">{{#if this.isActive}}<span class="lf-badge-live">{{../label.setInitial}}</span>{{/if}}<i class="fa-solid fa-image"></i> Scene</div>
            {{/if}}
            {{#if (lumenn-eq this.type 'audio')}}
            <div class="lf-node-title"><i class="fa-solid fa-music"></i> {{this.audioLabel}}</div>
            <div class="lf-node-tag"><span class="lf-audio-role-badge">{{this.audioRoleLabel}}</span> {{this.audioBadge}}</div>
            <div class="lf-node-wave"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
            {{/if}}
            {{#if (lumenn-eq this.type 'note')}}
            <div class="lf-node-title">{{this.data.title}}</div>
            <div class="lf-node-body">{{this.data.body}}</div>
            <div class="lf-node-tag"><i class="fa-solid fa-note-sticky"></i> Note</div>
            {{/if}}
          </div>
          <div class="lf-ports">
            {{#if (lumenn-eq this.type 'scene')}}
            <span class="lf-port lf-port-in lf-port-flow-in" data-port="flow-in" data-node="{{this.id}}" title="FLOW IN"></span>
            <span class="lf-port lf-port-out lf-port-flow-out" data-port="flow-out" data-node="{{this.id}}" title="FLOW OUT"></span>
            <span class="lf-port lf-port-audio" data-port="audio-in" data-node="{{this.id}}" title="AUDIO IN"></span>
            {{/if}}
            {{#if (lumenn-eq this.type 'audio')}}
            <span class="lf-port lf-port-in lf-port-audio" data-port="audio-in" data-node="{{this.id}}" title="AUDIO IN"></span>
            <span class="lf-port lf-port-out lf-port-audio" data-port="audio-out" data-node="{{this.id}}" title="AUDIO OUT"></span>
            {{/if}}
          </div>
        </div>
        {{/each}}
      </div>
      {{#if showConnectHint}}
      <div class="lf-connect-hint">{{connectHint}}</div>
      {{/if}}
      {{#if editable}}
      <div class="lf-audio-legend" aria-label="Legenda de áudio">
        <span class="lf-audio-key lf-audio-key-scene"><i></i>{{label.scene}}</span>
        <span class="lf-audio-key lf-audio-key-music"><i></i>{{label.musicRole}}</span>
        <span class="lf-audio-key lf-audio-key-sfx"><i></i>{{label.sfxRole}}</span>
        <span class="lf-audio-key lf-audio-key-note"><i></i>{{label.note}}</span>
        <span class="lf-audio-key lf-audio-key-active"><i></i>{{label.activeState}}</span>
        <span class="lf-audio-key lf-audio-key-navigable"><i></i>{{label.navigableState}}</span>
        <span class="lf-audio-key lf-audio-key-selected"><i></i>{{label.selectedState}}</span>
        <span class="lf-audio-key lf-audio-key-target"><i></i>{{label.targetState}}</span>
        <span class="lf-audio-key lf-audio-key-flow-in"><i></i>FLOW IN</span>
        <span class="lf-audio-key lf-audio-key-flow-out"><i></i>FLOW OUT</span>
        <span class="lf-audio-key lf-audio-key-left"><i></i>L / IN</span>
        <span class="lf-audio-key lf-audio-key-right"><i></i>R / OUT</span>
      </div>
      {{/if}}
      {{#if transitioning}}
      <div class="lf-transitioning"><span class="lf-transitioning-dot"></span>{{label.transition}}</div>
      {{/if}}
      {{#unless nodes.length}}
      <div class="lf-empty-state">
        <div class="lf-empty-icon"><i class="fa-solid fa-image"></i></div>
        <div class="lf-empty-title">{{label.emptyState}}</div>
        <div class="lf-empty-hint">{{label.emptyHint}}<br>{{label.dropHint}}</div>
      </div>
      {{/unless}}
    </div>

    <div class="lf-inspector">
      {{#if (lumenn-eq inspector.kind 'node')}}
        {{#if (lumenn-eq inspector.nodeType 'scene')}}
        <h3 class="lf-insp-title">{{label.scene}}</h3>
        <label class="lf-insp-label">{{label.sceneDoc}}</label>
        <select data-insp="data.sceneId">
          <option value="">{{label.none}}</option>
          {{#each inspector.scenes}}
          <option value="{{this.id}}" {{#if (lumenn-eq this.id ../inspector.node.data.sceneId)}}selected{{/if}}>{{this.name}}</option>
          {{/each}}
        </select>
        {{/if}}
        {{#if (lumenn-eq inspector.nodeType 'scene')}}
        <h3 class="lf-insp-title">{{label.connections}}</h3>
        {{#if editable}}
        <label class="lf-insp-label">{{label.outgoing}}</label>
        {{#if inspector.flowTargets.length}}
        <select data-insp-pick="flowTarget">
          {{#each inspector.flowTargets}}<option value="{{this.id}}">{{this.name}}</option>{{/each}}
        </select>
        <div class="lf-insp-actions"><button data-insp-action="add-flow">{{label.addDestination}}</button></div>
        {{else}}
        <p class="lf-insp-p">{{label.noScenes}}</p>
        {{/if}}
        <label class="lf-insp-label">{{label.attachAudio}}</label>
        {{#if inspector.audioNodes.length}}
        <select data-insp-pick="audioAttach">
          {{#each inspector.audioNodes}}<option value="{{this.id}}">{{this.name}}</option>{{/each}}
        </select>
        <div class="lf-insp-actions"><button data-insp-action="attach-audio">{{label.attachAudio}}</button></div>
        {{else}}
        <p class="lf-insp-p">{{label.noAudioNodes}}</p>
        {{/if}}
        {{/if}}
        {{#if inspector.nodeEdges.length}}
        <label class="lf-insp-label">{{label.incoming}} / {{label.outgoing}}</label>
        <ul class="lf-insp-edges">
          {{#each inspector.nodeEdges}}
          <li>
            <button class="lf-insp-edge-open" data-insp-action="select-edge" data-insp-edge="{{this.id}}" title="{{../../label.editTransition}}">
              <span class="lf-insp-edge-dir">{{#if (lumenn-eq this.from ../inspector.node.id)}}&rarr;{{else}}&larr;{{/if}}</span>
              <span>{{this.fromLabel}} &rarr; {{this.toLabel}}</span>
            </button>
            <button class="lf-insp-x" data-insp-action="delete-edge" data-insp-edge="{{this.id}}" title="{{../../label.delete}}">&#10005;</button>
          </li>
          {{/each}}
        </ul>
        {{/if}}
        {{/if}}
        {{#if (lumenn-eq inspector.nodeType 'audio')}}
        <h3 class="lf-insp-title">{{label.audio}}</h3>
        <label class="lf-insp-label">{{label.audioRole}}</label>
        <select data-insp="data.audioRole">
          <option value="music" {{#if (lumenn-eq inspector.audioRole 'music')}}selected{{/if}}>{{label.musicRole}}</option>
          <option value="sfx" {{#if (lumenn-eq inspector.audioRole 'sfx')}}selected{{/if}}>{{label.sfxRole}}</option>
        </select>
        <label class="lf-insp-label">{{label.source}}</label>
        <select data-insp="data.audioType">
          <option value="">{{label.none}}</option>
          <option value="playlist" {{#if (lumenn-eq inspector.node.data.audioType 'playlist')}}selected{{/if}}>Playlist</option>
          <option value="track" {{#if (lumenn-eq inspector.node.data.audioType 'track')}}selected{{/if}}>Track</option>
        </select>
        {{#if (lumenn-eq inspector.node.data.audioType 'playlist')}}
        <select data-insp="data.audioId">
          <option value="">{{label.none}}</option>
          {{#each inspector.playlistsForAudio}}
          <option value="{{this.id}}" {{#if (lumenn-eq this.id ../inspector.node.data.audioId)}}selected{{/if}}>{{this.name}}</option>
          {{/each}}
        </select>
        {{/if}}
        {{#if (lumenn-eq inspector.node.data.audioType 'track')}}
        <select data-insp="data.audioId">
          <option value="">{{label.none}}</option>
          {{#each inspector.playlistsForAudio}}
          {{#each this.sounds}}
          <option value="{{this.uuid}}" {{#if (lumenn-eq this.uuid ../../inspector.node.data.audioId)}}selected{{/if}}>{{../name}} / {{this.name}}</option>
          {{/each}}
          {{/each}}
        </select>
        {{/if}}
        <label class="lf-insp-label">{{label.volume}}</label>
        <input type="range" min="0" max="1" step="0.05" data-insp="data.volume" value="{{inspector.node.data.volume}}">
        <label class="lf-insp-label lf-insp-check"><input type="checkbox" data-insp="data.loop" {{#if inspector.node.data.loop}}checked{{/if}}> {{label.loop}}</label>
        {{/if}}
        {{#if (lumenn-eq inspector.nodeType 'note')}}
        <h3 class="lf-insp-title">{{label.note}}</h3>
        <label class="lf-insp-label">{{label.title}}</label>
        <input type="text" data-insp-input="data.title" value="{{inspector.node.data.title}}">
        <label class="lf-insp-label">{{label.body}}</label>
        <textarea data-insp-input="data.body" rows="4">{{inspector.node.data.body}}</textarea>
        {{/if}}
        <label class="lf-insp-label">{{label.color}}</label>
        <div class="lf-swatches">
          {{#each inspector.colors}}
          <span class="lf-swatch" data-insp-swatch data-color="{{this}}" style="background:{{this}}"></span>
          {{/each}}
        </div>
        <label class="lf-insp-label">{{label.size}}</label>
        <select data-insp="size">
          {{#each inspector.sizes}}
          <option value="{{this}}" {{#if (lumenn-eq this ../inspector.node.size)}}selected{{/if}}>{{this}}</option>
          {{/each}}
        </select>
        <label class="lf-insp-label">{{label.notes}}</label>
        <textarea data-insp-input="notes" rows="3">{{inspector.node.notes}}</textarea>
        {{#if editable}}
        <div class="lf-insp-actions">
          <button data-insp-action="set-initial">{{label.setInitial}}</button>
          <button class="danger" data-insp-action="delete-node">{{label.delete}}</button>
        </div>
        {{/if}}
      {{/if}}

      {{#if (lumenn-eq inspector.kind 'edge')}}
        {{#if (lumenn-eq inspector.edgeType 'flow')}}
        <h3 class="lf-insp-title">{{label.flowEdge}} <span class="lf-insp-native">{{#if inspector.hasNativeTransitions}}{{label.v14Native}}{{else}}{{label.fallbackMode}}{{/if}}</span></h3>
        <p class="lf-insp-p">{{label.from}}: {{inspector.fromLabel}} &rarr; {{label.to}}: {{inspector.toLabel}}</p>
        <label class="lf-insp-label">{{label.transitionScope}}</label>
        <select data-insp="transition.scope">
          <option value="audio" {{#if (lumenn-eq inspector.transitionScope 'audio')}}selected{{/if}}>{{label.audioOnly}}</option>
          <option value="scene" {{#if (lumenn-eq inspector.transitionScope 'scene')}}selected{{/if}}>{{label.sceneOnly}}</option>
          <option value="both" {{#if (lumenn-eq inspector.transitionScope 'both')}}selected{{/if}}>{{label.beatBoth}}</option>
        </select>
        <label class="lf-insp-label">{{label.sceneTrans}}</label>
        <select data-insp="transition.scene.type">
          <option value="cut" {{#if (lumenn-eq inspector.edge.transition.scene.type 'cut')}}selected{{/if}}>{{label.cut}}</option>
          {{#each inspector.sceneTransitions}}
          <option value="{{this.id}}" {{#if (lumenn-eq this.id ../inspector.edge.transition.scene.type)}}selected{{/if}}>{{this.label}}</option>
          {{/each}}
        </select>
        <label class="lf-insp-label">{{label.duration}} (ms)</label>
        <input type="number" min="0" step="100" data-insp="transition.scene.duration" value="{{inspector.edge.transition.scene.duration}}">
        <label class="lf-insp-label">{{label.color}}</label>
        <input type="color" data-insp="transition.scene.color" value="{{inspector.sceneColor}}">
        <label class="lf-insp-label">{{label.audioTrans}}</label>
        <select data-insp="transition.audio.mode">
          <option value="auto" {{#if (lumenn-eq inspector.edge.transition.audio.mode 'auto')}}selected{{/if}}>{{label.auto}}</option>
          <option value="keep" {{#if (lumenn-eq inspector.edge.transition.audio.mode 'keep')}}selected{{/if}}>{{label.keep}}</option>
          <option value="cut" {{#if (lumenn-eq inspector.edge.transition.audio.mode 'cut')}}selected{{/if}}>{{label.cut}}</option>
          <option value="crossfade" {{#if (lumenn-eq inspector.edge.transition.audio.mode 'crossfade')}}selected{{/if}}>{{label.crossfade}}</option>
          <option value="fadeout" {{#if (lumenn-eq inspector.edge.transition.audio.mode 'fadeout')}}selected{{/if}}>{{label.fadeout}}</option>
          <option value="fadein" {{#if (lumenn-eq inspector.edge.transition.audio.mode 'fadein')}}selected{{/if}}>{{label.fadein}}</option>
        </select>
        <label class="lf-insp-label">{{label.crossfadeDur}} (ms)</label>
        <input type="number" min="0" step="100" data-insp="transition.audio.crossfadeDuration" value="{{inspector.edge.transition.audio.crossfadeDuration}}">
        <label class="lf-insp-label">{{label.fadeIn}} (ms)</label>
        <input type="number" min="0" step="100" data-insp="transition.audio.fadeInDuration" value="{{inspector.edge.transition.audio.fadeInDuration}}">
        <label class="lf-insp-label">{{label.fadeOut}} (ms)</label>
        <input type="number" min="0" step="100" data-insp="transition.audio.fadeOutDuration" value="{{inspector.edge.transition.audio.fadeOutDuration}}">
        <label class="lf-insp-label">{{label.curve}}</label>
        <select data-insp="transition.audio.curve">
          {{#each inspector.curveOptions}}
          <option value="{{this}}" {{#if (lumenn-eq this ../inspector.edge.transition.audio.curve)}}selected{{/if}}>{{this}}</option>
          {{/each}}
        </select>
        {{#if editable}}
        {{#if inspector.hasNativeTransitions}}
        <div class="lf-insp-actions"><button data-insp-action="preview-transition">{{label.preview}}</button></div>
        {{/if}}
        <div class="lf-insp-actions">
          {{#if inspector.reverse}}
          <button disabled>{{label.bidirectional}}</button>
          {{else}}
          <button data-insp-action="add-return">{{label.addReturn}}</button>
          {{/if}}
          <button class="danger" data-insp-action="delete-edge">{{label.delete}}</button>
        </div>
        {{/if}}
        {{else}}
        <h3 class="lf-insp-title">{{label.audioEdge}}</h3>
        <p class="lf-insp-p">{{label.from}}: {{inspector.fromLabel}} &rarr; {{label.to}}: {{inspector.toLabel}}</p>
        <p class="lf-insp-p lf-audio-routing-note">{{label.audioRoutingNote}}</p>
        <label class="lf-insp-label">{{label.audioTrans}}</label>
        <select data-insp="transition.audio.mode">
          <option value="auto" {{#if (lumenn-eq inspector.audioTransition.mode 'auto')}}selected{{/if}}>{{label.auto}}</option>
          <option value="keep" {{#if (lumenn-eq inspector.audioTransition.mode 'keep')}}selected{{/if}}>{{label.keep}}</option>
          <option value="cut" {{#if (lumenn-eq inspector.audioTransition.mode 'cut')}}selected{{/if}}>{{label.cut}}</option>
          <option value="crossfade" {{#if (lumenn-eq inspector.audioTransition.mode 'crossfade')}}selected{{/if}}>{{label.crossfade}}</option>
          <option value="fadeout" {{#if (lumenn-eq inspector.audioTransition.mode 'fadeout')}}selected{{/if}}>{{label.fadeout}}</option>
          <option value="fadein" {{#if (lumenn-eq inspector.audioTransition.mode 'fadein')}}selected{{/if}}>{{label.fadein}}</option>
        </select>
        <label class="lf-insp-label">{{label.crossfadeDur}} (ms)</label>
        <input type="number" min="0" max="10000" step="50" data-insp="transition.audio.crossfadeDuration" value="{{inspector.audioTransition.crossfadeDuration}}">
        <label class="lf-insp-label">{{label.fadeIn}} (ms)</label>
        <input type="number" min="0" max="10000" step="50" data-insp="transition.audio.fadeInDuration" value="{{inspector.audioTransition.fadeInDuration}}">
        <label class="lf-insp-label">{{label.fadeOut}} (ms)</label>
        <input type="number" min="0" max="10000" step="50" data-insp="transition.audio.fadeOutDuration" value="{{inspector.audioTransition.fadeOutDuration}}">
        <label class="lf-insp-label">{{label.curve}}</label>
        <select data-insp="transition.audio.curve">
          {{#each inspector.curveOptions}}
          <option value="{{this}}" {{#if (lumenn-eq this ../inspector.audioTransition.curve)}}selected{{/if}}>{{this}}</option>
          {{/each}}
        </select>
        {{#if editable}}
        <div class="lf-insp-actions"><button class="danger" data-insp-action="delete-edge">{{label.delete}}</button></div>
        {{/if}}
        {{/if}}
      {{/if}}

      {{#if (lumenn-eq inspector.kind 'graph')}}
      <h3 class="lf-insp-title">{{label.graph}}</h3>
      <p class="lf-insp-p">{{activeGraph.name}}</p>
      <p class="lf-insp-p">{{nodes.length}} nodes &middot; {{edgeCount}} edges</p>
      <p class="lf-insp-p">Schema v2 &middot; graph editor</p>
      {{#if inspector.audioNodeIndex.length}}
      <label class="lf-insp-label">{{label.audioNodes}}</label>
      <ul class="lf-insp-edges lf-audio-node-index">
        {{#each inspector.audioNodeIndex}}
        <li>
          <button class="lf-insp-edge-open" data-insp-action="focus-node" data-insp-node="{{this.id}}" title="{{../label.focusNode}}">
            <i class="fa-solid fa-music"></i>
            <span>{{this.name}}</span>
          </button>
        </li>
        {{/each}}
      </ul>
      {{/if}}
      {{#if editable}}
      <div class="lf-insp-actions">
        <button data-insp-action="rename-graph">{{label.renameGraph}}</button>
        <button class="danger" data-insp-action="delete-graph">{{label.deleteGraph}}</button>
      </div>
      {{/if}}
      {{/if}}
    </div>
  </div>
</div>
